<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perception_qr</name>
  <version>0.1.0</version>
  <description>QR detection/decoding (OpenCV QRCodeDetector) — scans the start QR and
               matches the target QR in the delivery zone. Publishes decode + match
               + an annotated image stream for the GCS.</description>
  <maintainer email="sarthakkhubchandanik@gmail.com">Team Rotor FPV</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <!-- pip: opencv-python numpy -->

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
