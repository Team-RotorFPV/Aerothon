{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AeroTHON GCS",
  "version": "0.1.0",
  "identifier": "com.teamrotorfpv.aerothon.gcs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "AeroTHON GCS", "width": 1280, "height": 800 }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
