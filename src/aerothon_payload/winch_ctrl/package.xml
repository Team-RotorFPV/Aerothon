<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>winch_ctrl</name>
  <version>0.1.0</version>
  <description>Winch state machine for the delivery payload. Subscribes
               /winch/cmd (previously nobody did), publishes /winch/status,
               and refuses to release unless altitude, hover stability and
               actuator health all check out.</description>
  <maintainer email="sarthakkhubchandanik@gmail.com">Team Rotor FPV</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
