<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>avoidance</name>
  <version>0.1.0</version>
  <description>Reactive corridor-centering + obstacle-braking velocity controller.
               Turns the RPLidar C1 /scan into body-frame velocity setpoints for
               ArduPilot GUIDED (MAVROS setpoint_raw/local, FRAME_BODY_NED).</description>
  <maintainer email="sarthakkhubchandanik@gmail.com">Team Rotor FPV</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
