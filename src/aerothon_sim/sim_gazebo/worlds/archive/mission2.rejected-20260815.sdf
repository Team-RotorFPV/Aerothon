<?xml version="1.0" ?>
<!-- AeroTHON 2026 Mission 2 course for Gazebo Harmonic (gz-sim 8).
     Rulebook Figure 3 training course: blue takeoff zone, start QR, green
     forward corridor, orange return corridor, black static obstacles, 40 x 30 m
     delivery zone, multiple target QR locations, and a red restricted zone.
     The standard ArduPilot Iris is spawned by sim_full.launch.py. -->
<sdf version="1.10">
  <world name="mission2">
    <gui fullscreen="false">
      <camera name="rulebook_course_view">
        <pose>-15 -24 27 0 0.62 0.78</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal>
          <size>200 200</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal>
          <size>200 200</size></plane></geometry>
          <material><ambient>0.25 0.27 0.3 1</ambient><diffuse>0.3 0.32 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Vehicle/sensor assets are supplied by the official ArduPilot Gazebo
         workspace and spawned by sim_full.launch.py. Keeping the course world
         free of a second hand-written flight model prevents two conflicting
         vehicles. -->

    <!-- Rulebook Figure 3: two 3.5 m-wide, 10 m-long return corridors. -->
    <model name="forward_corridor_floor"><static>true</static><pose>5 2.2 0.012 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>10 3.5 0.02</size></box></geometry>
        <material><ambient>0.08 0.55 0.20 1</ambient><diffuse>0.08 0.55 0.20 1</diffuse></material></visual></link></model>
    <model name="return_corridor_floor"><static>true</static><pose>5 -2.2 0.013 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>10 3.5 0.02</size></box></geometry>
        <material><ambient>0.93 0.42 0.08 1</ambient><diffuse>0.93 0.42 0.08 1</diffuse></material></visual></link></model>
    <model name="corridor_outer_north"><static>true</static><pose>5 3.95 1.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>10 0.10 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10 0.10 3</size></box></geometry><material><ambient>0.1 0.35 0.8 1</ambient><diffuse>0.1 0.35 0.8 1</diffuse></material></visual></link></model>
    <model name="corridor_middle"><static>true</static><pose>5 0 1.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>10 0.10 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10 0.10 3</size></box></geometry><material><ambient>0.1 0.35 0.8 1</ambient><diffuse>0.1 0.35 0.8 1</diffuse></material></visual></link></model>
    <model name="corridor_outer_south"><static>true</static><pose>5 -3.95 1.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>10 0.10 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10 0.10 3</size></box></geometry><material><ambient>0.1 0.35 0.8 1</ambient><diffuse>0.1 0.35 0.8 1</diffuse></material></visual></link></model>

    <!-- Black static obstacles in the forward and return lanes. -->
    <!-- The green forward lane is clear; obstacles are placed only on the
         orange return lane as shown in the rulebook figure. -->
    <model name="static_obstacle_4"><static>true</static><pose>3.5 -2.8 0.75 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.7 1.0 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.7 1.0 1.5</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual></link></model>
    <model name="static_obstacle_5"><static>true</static><pose>7.0 -1.0 0.75 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.7 1.0 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.7 1.0 1.5</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual></link></model>
    <model name="static_obstacle_6"><static>true</static><pose>9.0 -2.8 0.75 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.7 1.0 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.7 1.0 1.5</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual></link></model>

    <!-- ============ Delivery zone marker (40 x 30) ============ -->
    <model name="delivery_zone"><static>true</static>
      <pose>30 0 0.01 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>40 30 0.02</size></box></geometry>
        <material><ambient>0.32 0.62 0.34 1</ambient><diffuse>0.32 0.62 0.34 1</diffuse></material></visual></link>
    </model>
    <model name="delivery_border_n"><static>true</static><pose>30 15 0.035 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>40 0.18 0.03</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="delivery_border_s"><static>true</static><pose>30 -15 0.035 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>40 0.18 0.03</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="delivery_border_e"><static>true</static><pose>50 0 0.035 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>0.18 30 0.03</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="delivery_border_w"><static>true</static><pose>10 0 0.035 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>0.18 30 0.03</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>

    <!-- ============ Red / restricted zone (8 x 8) ============ -->
    <model name="red_zone"><static>true</static>
      <pose>38 5 0.02 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>8 8 0.03</size></box></geometry>
        <material><ambient>0.75 0.22 0.17 1</ambient><diffuse>0.75 0.22 0.17 1</diffuse></material></visual></link>
    </model>

    <!-- Decodable QR boards. The start QR is 1 m ahead of the takeoff pad;
         the delivery QR boards are enlarged to 2.5 m for the 10 m scan. -->
    <model name="qr_start"><static>true</static><pose>-0.5 0 0.04 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><plane><normal>0 0 1</normal><size>2.0 2.0</size></plane></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>@SIM_GAZEBO_ASSET_URI@/qr_start.png</albedo_map><roughness>1</roughness><metalness>0</metalness></metal></pbr></material></visual></link></model>
    <model name="qr_target"><static>true</static><pose>30 -6 0.03 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><plane><normal>0 0 1</normal><size>2.5 2.5</size></plane></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>@SIM_GAZEBO_ASSET_URI@/qr_target_a.png</albedo_map><roughness>1</roughness><metalness>0</metalness></metal></pbr></material></visual></link></model>
    <model name="qr_3"><static>true</static><pose>40 10 0.03 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><plane><normal>0 0 1</normal><size>2.5 2.5</size></plane></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>@SIM_GAZEBO_ASSET_URI@/qr_target_b.png</albedo_map><roughness>1</roughness><metalness>0</metalness></metal></pbr></material></visual></link></model>
    <model name="qr_4"><static>true</static><pose>42 -10 0.03 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><plane><normal>0 0 1</normal><size>2.5 2.5</size></plane></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>@SIM_GAZEBO_ASSET_URI@/qr_target_c.png</albedo_map><roughness>1</roughness><metalness>0</metalness></metal></pbr></material></visual></link></model>
    <model name="qr_5"><static>true</static><pose>20 10 0.03 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><plane><normal>0 0 1</normal><size>2.5 2.5</size></plane></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>@SIM_GAZEBO_ASSET_URI@/qr_target_d.png</albedo_map><roughness>1</roughness><metalness>0</metalness></metal></pbr></material></visual></link></model>
    <model name="qr_6"><static>true</static><pose>20 -9 0.03 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><plane><normal>0 0 1</normal><size>2.5 2.5</size></plane></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>@SIM_GAZEBO_ASSET_URI@/qr_target_e.png</albedo_map><roughness>1</roughness><metalness>0</metalness></metal></pbr></material></visual></link></model>

    <!-- ============ Start / land pad ============ -->
    <model name="start_pad"><static>true</static><pose>-2 0 0.02 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>2 2 0.02</size></box></geometry>
        <material><ambient>0.18 0.8 0.44 1</ambient><diffuse>0.18 0.8 0.44 1</diffuse></material></visual></link></model>
    <model name="takeoff_landing_zone"><static>true</static><pose>-2 0 0.01 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>3 6 0.015</size></box></geometry>
        <material><ambient>0.08 0.35 0.75 1</ambient><diffuse>0.08 0.35 0.75 1</diffuse></material></visual></link></model>

    <!-- ============ Green corridor-entrance banner ============ -->
    <model name="green_banner"><static>true</static><pose>0 2.2 2.4 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><plane><normal>-1 0 0</normal><size>3.4 1.2</size></plane></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>@SIM_GAZEBO_ASSET_URI@/banner.png</albedo_map><roughness>1</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="left_post"><pose>0 1.65 -1.2 0 0 0</pose><geometry><box><size>0.12 0.12 2.4</size></box></geometry><material><ambient>0.05 0.45 0.16 1</ambient><diffuse>0.05 0.45 0.16 1</diffuse></material></visual>
        <visual name="right_post"><pose>0 -1.65 -1.2 0 0 0</pose><geometry><box><size>0.12 0.12 2.4</size></box></geometry><material><ambient>0.05 0.45 0.16 1</ambient><diffuse>0.05 0.45 0.16 1</diffuse></material></visual>
      </link></model>
  </world>
</sdf>
