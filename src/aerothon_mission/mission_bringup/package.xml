<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mission_bringup</name>
  <version>0.1.0</version>
  <description>Top-level + per-subsystem launch files for Mission 2 (sim/real via args).</description>
  <maintainer email="sarthakkhubchandanik@gmail.com">Team Rotor FPV</maintainer>
  <license>MIT</license>

  <exec_depend>mavros</exec_depend>
  <exec_depend>perception_qr</exec_depend>
  <exec_depend>perception_banner</exec_depend>
  <exec_depend>avoidance</exec_depend>
  <exec_depend>mission_bt</exec_depend>
  <exec_depend>web_video_server</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>uav_description</exec_depend>
  <exec_depend>camera_ctrl</exec_depend>
  <exec_depend>winch_ctrl</exec_depend>
  <exec_depend>perception_overlay</exec_depend>
  <exec_depend>perception_redzone</exec_depend>
  <exec_depend>gcs_aggregator</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>ldlidar_stl_ros2</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export><build_type>ament_python</build_type></export>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>aerothon_slam_grid</exec_depend>
</package>
